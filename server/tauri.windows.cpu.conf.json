{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "jieqilink",
    "version": "0.1.6",
    "identifier": "top.itmeng.jieqilinkdev",
    "build": {
        "beforeDevCommand": "pnpm dev",
        "devUrl": "http://localhost:1420",
        "beforeBuildCommand": "pnpm build",
        "frontendDist": "../dist",
        "removeUnusedCommands": true
    },
    "app": {
        "windows": [
            {
                "title": "揭棋连线",
                "width": 660,
                "height": 580,
                "resizable": false,
                "hiddenTitle": true,
                "fullscreen": false,
                "maximizable": false
            }
        ],
        "security": {
            "csp": null
        }
    },
    "bundle": {
        "active": true,
        "targets": "msi",
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/128x128@2x.png",
            "icons/icon.icns",
            "icons/icon.ico"
        ],
        "windows": {
            "allowDowngrades": true,
            "certificateThumbprint": null,
            "digestAlgorithm": null,
            "nsis": null,
            "signCommand": null,
            "timestampUrl": null,
            "tsp": false,
            "webviewInstallMode": {
                "silent": true,
                "type": "downloadBootstrapper"
            },
            "wix": {
                "language": "zh-CN"
            }
        },
        "resources": {
            "../libs/windows-cpu/*.dll": "./",
            "../libs/pikajieqi/pikajieqi-windows.exe": "../libs/pikajieqi/pikajieqi-windows.exe",
            "../libs/pikajieqi/pikajieqi.nnue": "../libs/pikajieqi/pikajieqi.nnue"
        }
    }
}